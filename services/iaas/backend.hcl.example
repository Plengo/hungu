# ─────────────────────────────────────────────────────────────────────────────
# Terraform OBS (S3-compatible) backend config — LOCAL USE ONLY
#
# 1. Copy this file:    cp backend.hcl.example backend.hcl
# 2. Fill in your AK/SK below
# 3. Init Terraform:    terraform init -backend-config=backend.hcl
#
# backend.hcl is gitignored — never commit it.
# The GitHub Actions workflow passes these values via secrets automatically.
# ─────────────────────────────────────────────────────────────────────────────

bucket = "hungu-tfstate"
key    = "hungu/terraform.tfstate"
region = "af-south-1"

# Huawei OBS S3-compatible endpoint for af-south-1 (Johannesburg)
endpoints = {
  s3 = "https://obs.af-south-1.myhuaweicloud.com"
}

# Your Huawei Cloud AK/SK
access_key = "your-hw-access-key"
secret_key = "your-hw-secret-key"

# Required flags for OBS compatibility with the S3 backend
skip_credentials_validation  = true
skip_metadata_api_check      = true
skip_region_validation       = true
skip_requesting_account_id   = true
skip_s3_checksum             = true
use_path_style               = true
