# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=dev

# ── Google Maps (Places autocomplete) ─────────────────────────────────────────
GMAPS_API_KEY=your_google_maps_api_key_here

# ── AI providers (cascade: Gemini → Groq → Mistral → OpenRouter → Cerebras → DeepSeek)
GEMINI_API_KEY=your_gemini_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GROQ_API_KEY=your_groq_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
CEREBRAS_API_KEY=your_cerebras_api_key_here
SAMBANOVA_API_KEY=your_sambanova_api_key_here

# ── Database ───────────────────────────────────────────────────────────────────
DB_URL=postgresql://hungu:hungu_secret@db/hungu
DB_USERNAME=hungu
DB_PASSWORD=hungu_secret

# ── App domain ─────────────────────────────────────────────────────────────────
DOMAIN=hungu.co.za

# ── Firebase (optional — for multi-provider auth) ─────────────────────────────
FIREBASE_CONFIG={}

# ── Worker ─────────────────────────────────────────────────────────────────────
# How often (seconds) the worker scrapes sources. Default: 3600 (1 hour)
SCRAPE_INTERVAL_SECS=3600

# ── API ────────────────────────────────────────────────────────────────────────
# JWT secret for user token signing (run: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_random_secret_string
# Shared secret between worker and API (run: openssl rand -hex 16)
WORKER_API_KEY=change_me_to_a_random_worker_key

# ── Admin ──────────────────────────────────────────────────────────────────────
# Admin panel key (run: openssl rand -hex 16)
ADMIN_SECRET=change_me_to_a_random_admin_key

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# ── Kimi ───────────────────────────────────────────────────────────────────────
KIMI_API_KEY=your_kimi_api_key_here
