# ── Gemini AI ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database ───────────────────────────────────────────────────────────────────
DB_URL=postgresql://hungu:hungu_secret@db/hungu
DB_USERNAME=hungu
DB_PASSWORD=hungu_secret

# ── App domain ─────────────────────────────────────────────────────────────────
DOMAIN=hungu.co.za

# ── Firebase (optional — for multi-provider auth) ─────────────────────────────
FIREBASE_CONFIG={}

# ── Worker ─────────────────────────────────────────────────────────────────────
# How often (seconds) the worker scrapes sources. Default: 3600 (1 hour)
SCRAPE_INTERVAL_SECS=3600

# ── API ────────────────────────────────────────────────────────────────────────
# JWT secret for user token signing (run: openssl rand -hex 32)
JWT_SECRET=change_me_to_a_random_secret_string
# Shared secret between worker and API (run: openssl rand -hex 16)
WORKER_API_KEY=change_me_to_a_random_worker_key
